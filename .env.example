# HelpDesk AI - Environment variables
# Copy to .env and adjust values for your environment.
# Docker is optional; point URLs to local or external services as needed.

# =========================
# App
# =========================
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000
WIDGET_CDN_URL=http://localhost:3001/widget.js

# =========================
# Database (PostgreSQL, TypeORM)
# =========================
# Full connection URL (preferred). Works with local Postgres or external providers.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/helpdesk_ai
# Optional discrete fields (used if your tooling prefers them; DATABASE_URL is primary)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=helpdesk_ai
DB_SSL=false
# Set true only when debugging; keep false in normal dev/prod
DB_LOGGING=false

# =========================
# Redis (BullMQ / queues / cache)
# =========================
# Redis is required to run BullMQ workers; absence should not block non-queue modules.
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# =========================
# Authentication / Security
# =========================
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
EMAIL_VERIFICATION_TOKEN_TTL=24h
PASSWORD_RESET_TOKEN_TTL=1h
BCRYPT_ROUNDS=12
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# =========================
# Email (for verification/reset - provider configured later)
# =========================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="HelpDesk AI <noreply@example.com>"

# =========================
# AI / Embeddings
# =========================
OPENAI_API_KEY=
AI_DEFAULT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# =========================
# Storage / Uploads
# =========================
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# =========================
# Observability
# =========================
LOG_LEVEL=debug
SENTRY_DSN=
